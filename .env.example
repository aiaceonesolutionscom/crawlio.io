# Frontend environment variables (Vite exposes only VITE_-prefixed vars to client code)

# Backend API base URL.
#   - Local dev:     http://localhost:8000
#   - Production:    leave EMPTY — the Docker nginx serves the SPA and proxies
#                    /api/* to the backend on the same origin (see nginx.conf).
#                    Empty string keeps same-origin /api/v1/... requests.
VITE_API_URL=

# Clerk publishable key (safe for client-side use)
VITE_CLERK_PUBLISHABLE_KEY=
