ENV=development
DATABASE_URL=postgresql+asyncpg://crawlio:crawlio@postgres:5432/crawlio
CORS_ORIGINS=["http://localhost:5173"]
REDIS_URL=redis://redis:6379/0

CLERK_JWKS_URL=
CLERK_ISSUER=
CLERK_SECRET_KEY=

# Emails that get super-admin access automatically on first login.
# Requires a custom "email" claim on the Clerk session token (Clerk Dashboard
# -> Sessions -> Customize session token -> add {"email": "{{user.primary_email_address}}"}).
SUPER_ADMIN_EMAILS=[]

BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
MISTRAL_API_KEY=

# Lead crawler (Google Maps + OpenStreetMap + directories) — free, open-source
# discovery sources. Defaults below are sane for local dev; override as needed.
GOOGLE_MAPS_MAX_RESULTS=50
GOOGLE_MAPS_HEADLESS=true
GOOGLE_MAPS_DELAY_SECONDS=1.5
GOOGLE_MAPS_SEARCH_LIMIT=20
# Optional residential/anti-bot proxy for the crawlers, e.g. http://user:pass@host:port
PROXY_URL=
DIRECTORY_ENABLED=true
# Geoapify Places — free OSM-based POI search (3,000 req/day, no billing card).
# Optional: discovery skips it when empty. Get a key at https://www.geoapify.com/.
GEOAPIFY_API_KEY=
# MX-record email verification (quality gate) — off by default for speed (no DNS
# dependency); set true for stricter deliverability checks.
VALIDATE_EMAILS=false

# Optional, opt-in last-resort top-up for thin markets where Google Maps + OSM +
# directories return fewer leads than requested. Off by default — only contributes
# name + website candidates (never guessed email/phone), gated by the same
# validation as every other source. Set TAVILY_ENABLED=true and provide a key to use it.
TAVILY_API_KEY=
TAVILY_ENABLED=false
TAVILY_MAX_RESULTS=10

# Shared, global cache of validated discovery results (niche+city+country),
# not per-workspace — repeat searches across every workspace/company reuse the
# same scrape instead of re-hitting Google Maps/OSM/directories every time.
DISCOVERY_CACHE_TTL_HOURS=24
# Background pre-warm crawler (Celery beat) that refreshes cache rows before
# they expire. Needs Redis + a running worker + beat process — off by default.
DISCOVERY_PREWARM_ENABLED=false
DISCOVERY_PREWARM_INTERVAL_MINUTES=10
DISCOVERY_PREWARM_BATCH_SIZE=2

# WhatsApp Business Platform (Meta Cloud API). Platform-level shared config: one
# Meta App backs every workspace; each workspace connects its own WABA + phone
# number via Embedded Signup or manual System User credentials.
META_APP_ID=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_GRAPH_VERSION=v21.0
WHATSAPP_WEBHOOK_URL=
# Dev-only test number credentials (Meta API Setup tab; temporary 24h token).
WHATSAPP_TEST_PHONE_NUMBER_ID=
WHATSAPP_TEST_ACCESS_TOKEN=
PRO_DAILY_WHATSAPP_LIMIT=200
ENTERPRISE_DAILY_WHATSAPP_LIMIT=1000
